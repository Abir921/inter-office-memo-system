# ---------------------------------------------------------------------------
# Inter-Office Memo Management System — environment template
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- Database (Neon Postgres) ----------------------------------------------
# LOCAL: use the "unpooled" / direct connection string from the Neon dashboard.
#        Prisma migrations need a direct connection.
# VERCEL: use the "pooled" string and append ?pgbouncer=true&connect_timeout=15
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require"

# --- Auth.js (NextAuth v5) --------------------------------------------------
# Generate a fresh one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Use a DIFFERENT value in production than in local development.
AUTH_SECRET="replace-me"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# --- Supabase Storage (private bucket for memo attachments) -----------------
# Phase 2. Leave blank until then; attachment upload is the only feature that
# needs it, and the app boots fine without it.
NEXT_PUBLIC_SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="memo-attachments"

# --- App --------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
